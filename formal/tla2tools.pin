TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
# JRE image, pinned by manifest-list digest (eclipse-temurin:17-jre as of 2026-11-25).
JRE_IMAGE=eclipse-temurin@sha256:541b08fc7f494edf14e436ff6bfb55767e4a115c87bfc547b8c5de957b58737f
